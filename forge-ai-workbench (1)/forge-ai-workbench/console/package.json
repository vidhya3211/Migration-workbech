{
  "name": "ai-workbench-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run gen:api && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
